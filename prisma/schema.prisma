// テーブル定義は docs/er.md に合わせる。
// user〜invitation は Better Auth の CLI（npx auth@1.7.27 generate）の出力。

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // シード（node で直接実行）からも読めるよう、import に .ts を付ける
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // 業務テーブルへの逆リレーション（CLI の出力に手で追加）
  staffProfiles   StaffProfile[]
  locations       Location[]
  services        Service[]
  customers       Customer[]
  reservations    Reservation[]
  attachments     Attachment[]
  subscription    Subscription?
  auditLogs       AuditLog[]
  customerExports CustomerExport[]
  jobs            Job[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // 業務テーブルへの逆リレーション（CLI の出力に手で追加）
  staffProfile StaffProfile?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------
// 業務テーブル（docs/er.md）。すべて organizationId を持つ。
// 組織をまたぐ参照は (organizationId, id) の複合外部キーで DB が拒否する
// （アプリの絞り込み漏れがあっても、他の組織の顧客で予約を作れない）。
// 日時は timestamptz で UTC として保存する。
// ---------------------------------------------------------------

enum ReservationStatus {
  pending
  confirmed
  cancelled
  done
}

model StaffProfile {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// メンバーを削除すると null になる（担当した予約の履歴を残すため、行は消さない）
  memberId       String?       @unique
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  displayName    String
  active         Boolean       @default(true)
  reservations   Reservation[]

  @@unique([organizationId, id])
  @@map("staffProfile")
}

model Location {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  timezone       String        @default("Asia/Tokyo")
  reservations   Reservation[]

  @@unique([organizationId, id])
  @@map("location")
}

model Service {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  priceYen        Int
  reservations    Reservation[]

  @@unique([organizationId, id])
  @@map("service")
}

model Customer {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameKana       String
  email          String
  phone          String
  note           String        @default("")
  /// 論理削除
  deletedAt      DateTime?     @db.Timestamptz(3)
  reservations   Reservation[]
  attachments    Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, nameKana])
  @@map("customer")
}

model Reservation {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: NoAction)
  staffProfileId String
  staffProfile   StaffProfile      @relation(fields: [organizationId, staffProfileId], references: [organizationId, id], onDelete: NoAction)
  customerId     String
  customer       Customer          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction)
  serviceId      String
  service        Service           @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: NoAction)
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         ReservationStatus @default(pending)
  /// 予約時点の料金を保存する（メニューの値上げで過去の売上が変わらない）
  priceYen       Int
  /// 楽観ロック。更新のたびに 1 増やす
  version        Int               @default(1)

  // 重複予約を防ぐ排他制約 reservation_no_overlap はスキーマで表せないので
  // マイグレーション SQL（20261123124219_reservation_exclusion）で追加している
  @@index([organizationId, startsAt])
  @@map("reservation")
}

enum AttachmentStatus {
  /// 署名付き URL を発行した（ブラウザからの PUT がまだ終わっていない）
  pending
  /// S3 にオブジェクトがあり、サイズと形式を確かめた
  uploaded
}

/// 顧客の写真・添付ファイル（F-12）。本体は S3 に置き、ここには鍵と属性だけを持つ
model Attachment {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer         @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: NoAction)
  s3Key            String           @unique
  /// 利用者が選んだファイル名（表示とダウンロード時の名前。S3 の鍵には使わない）
  fileName         String
  contentType      String
  sizeBytes        Int
  status           AttachmentStatus @default(pending)
  uploadedByUserId String
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, customerId])
  @@map("attachment")
}

enum CustomerExportStatus {
  pending
  done
  failed
}

/// 顧客一覧の CSV エクスポート（F-11）。Worker が CSV を作って S3 に置く
model CustomerExport {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUserId String
  status            CustomerExportStatus @default(pending)
  s3Key             String?
  rowCount          Int?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("customerExport")
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

/// 非同期ジョブ（Worker が処理する）。SQS のメッセージには id だけを載せ、
/// 中身はここに置く（Transactional Outbox。業務の変更と同じトランザクションで作る）。
/// idempotencyKey で同じ依頼を 1 件にまとめ、status で二重の処理を防ぐ
model Job {
  id             String        @id @default(cuid())
  /// パスワード再設定のメールなど、組織に属さないジョブは null
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// mail.send・reservation.confirmed・reservation.reminder・customer.export
  type           String
  payload        Json
  idempotencyKey String        @unique
  status         JobStatus     @default(queued)
  /// 処理を始めた回数（3 回失敗すると failed。SQS はデッドレターキューへ移す）
  attempts       Int           @default(0)
  /// running の間、この時刻までは他の Worker が処理しない
  lockedUntil    DateTime?     @db.Timestamptz(3)
  lastError      String?
  /// 最後に SQS へ送った日時（null なら未送信。Worker が拾い直して送る）
  publishedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?     @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("job")
}

/// 組織の契約（F-14、docs/billing.md）。課金の単位は組織で、1 組織 1 行。
/// 行がない組織は Free。Stripe の状態は Webhook でだけ書き換える
model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Checkout の前にサーバーが作る Stripe の顧客（Webhook はこれで組織を引く）
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  /// free | pro。機能制限はこの値で判定する
  plan                 String       @default("free")
  /// Stripe のサブスクリプションの status（none は申し込み前）
  status               String
  currentPeriodEnd     DateTime?    @db.Timestamptz(3)
  /// 期間の終わりに解約する予約（カスタマーポータルで解約した）
  cancelAtPeriodEnd    Boolean      @default(false)
  stripePriceId        String?
  /// 反映した最後のイベントの作成日時（Stripe の event.created）。
  /// これより古いイベントが後から届いても反映しない
  lastEventAt          DateTime?    @db.Timestamptz(3)

  @@map("subscription")
}

/// 受け取った Stripe のイベント（Webhook の冪等性）。同じイベントが
/// 2 回届いても、主キーの一意制約で 2 回目は処理しない。
/// 処理と同じトランザクションで作るので、処理に失敗したら残らない
/// （Stripe の再送で処理し直す）
model StripeEvent {
  /// Stripe のイベント ID（evt_...）
  id             String   @id
  type           String
  /// 組織が分からないイベント（対象外の種類・知らない顧客）は null
  organizationId String?
  /// applied（反映した）・stale（より新しいイベントを反映済み）・ignored（対象外）
  result         String
  /// Stripe がイベントを作った日時（event.created）
  createdAt      DateTime @db.Timestamptz(3)
  receivedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("stripeEvent")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  /// customer.update など
  action         String
  targetType     String
  targetId       String
  diff           Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("auditLog")
}
