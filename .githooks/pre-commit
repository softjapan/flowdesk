#!/bin/bash
# コミット前の品質ゲート。npm install 時に prepare スクリプトが
# core.hooksPath を .githooks に向けるので、clone した全員に効く。
set -e

# 1. 秘密情報らしきものがステージされていないか（.env などのファイル名と、
#    追加した行の本物の鍵の形。ルールは scripts/secret-rules.ts、第14章）
npx --no-install tsx scripts/scan-secrets.ts --staged

# 2. 型チェック・Lint・整形・テスト
npm run --silent check
