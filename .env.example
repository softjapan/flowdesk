# cp .env.example .env.local で作成する。値はローカル開発用（compose.yaml と合わせる）
DATABASE_URL="postgresql://flowdesk:flowdesk@localhost:5432/flowdesk"
# npm run test:db が使う DB（全テーブルを空にするので名前は _test で終える）。
# 未設定なら DATABASE_URL の DB 名を flowdesk_test にしたものを使う
# TEST_DATABASE_URL="postgresql://flowdesk:flowdesk@localhost:5432/flowdesk_test"

# Better Auth（src/server/auth.ts）。秘密鍵は 32 文字以上のランダムな値にする：
#   openssl rand -base64 32
# 本番では必ず別の値を設定する（未設定だと本番では認証の API がすべて失敗する）
BETTER_AUTH_SECRET="change-me-to-a-random-32-chars-or-more"
# アプリの公開 URL。メールのリンクや Cookie・オリジンの確認に使う
BETTER_AUTH_URL="http://localhost:3000"

# 添付ファイルと CSV エクスポート（第11章）。ローカルは RustFS。
# バケットと CORS は npm run aws:setup で作る（CORS は BETTER_AUTH_URL を許可する）。
# ブラウザもこの URL に直接 PUT・GET するので、ブラウザから届くホスト名にする。
# 本番（AWS の S3）では S3_ENDPOINT を設定しない
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="flowdesk-uploads"
# ジョブのキュー（第11章）。ローカルは ElasticMQ（docker/elasticmq.conf）。
# Worker は npm run worker で別に起動する。本番では SQS_ENDPOINT を設定しない
SQS_ENDPOINT="http://localhost:9324"
SQS_QUEUE_URL="http://localhost:9324/000000000000/flowdesk-jobs"
# 前日リマインドを探す間隔（ミリ秒）。既定は 15 分
# WORKER_REMINDER_INTERVAL_MS="900000"
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID="flowdesk"
AWS_SECRET_ACCESS_KEY="flowdesk-secret"

SMTP_HOST="localhost"
SMTP_PORT="1025"
# 本番（SES の SMTP など）で認証が必要なときだけ設定する。Mailpit では不要
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="FlowDesk <no-reply@flowdesk.local>"
