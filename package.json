{
  "name": "flowdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "aws:setup": "tsx scripts/setup-local-aws.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/client-sqs": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
